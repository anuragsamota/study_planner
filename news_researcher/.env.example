# LLM (optional) - without a key the pipeline runs in heuristic mode
ANTHROPIC_API_KEY=
# NR_LLM_PROVIDER=auto            # auto | anthropic | ollama | none
# NR_LLM_MODEL=claude-sonnet-5-5
# NR_OLLAMA_BASE_URL=http://localhost:11434

# Extra sources (optional) - GDELT and Google News need no key
NEWSAPI_KEY=
TAVILY_API_KEY=

# Vector DB / embeddings
# NR_VECTOR_BACKEND=auto          # auto | chroma | local | none
# NR_VECTOR_DB_PATH=.news_researcher/vectordb
# NR_EMBEDDING_PROVIDER=hashing   # hashing | ollama

# Agent behaviour
# NR_MAX_SUB_QUERIES=5
# NR_MAX_ITERATIONS=2
